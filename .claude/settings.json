{
  "permissions": {
    "allow": [
      "mcp__codegraph__codegraph_explore",
      "mcp__codegraph__codegraph_search",
      "mcp__codegraph__codegraph_node",
      "mcp__codegraph__codegraph_callers",
      "mcp__codegraph__codegraph_callees",
      "mcp__codegraph__codegraph_impact",
      "mcp__codegraph__codegraph_files",
      "mcp__codegraph__codegraph_status",
      "Bash(npx -y modern-web-guidance@latest search:*)",
      "Bash(npx -y modern-web-guidance@latest retrieve:*)"
    ]
  },
  "env": {
    "DISABLE_TELEMETRY": "1"
  },
  "extraKnownMarketplaces": {
    "qatools": {
      "source": {
        "source": "git",
        "url": "git@github.com:scylladb/qatools.git"
      }
    },
    "googlechrome": {
      "source": {
        "source": "github",
        "repo": "GoogleChrome/modern-web-guidance"
      }
    }
  },
  "enabledPlugins": {
    "qatools-sdlc@qatools": true,
    "modern-web-guidance@googlechrome": true
  }
}
